{
	"name": "phi-ill-sync",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-30",
	"account_id": "84f15756736ca53a547ffa05d311056f",
	"workers_dev": true,
	"preview_urls": false,
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"r2_buckets": [
		{
			"binding": "ILLS",
			"bucket_name": "phi-web-assets"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "b3219909ec754ce99345167611cc3b28"
		}
	],
	"vars": {
		"ILL_REPO": "Catrong/phi-plugin-ill",
		"ILL_REF": "main",
		"ILL_PREFIX": "original_ill",
		"ILL_DIRS": "SP,chap",
		"INFO_REPO": "Catrong/phi-plugin",
		"INFO_REF": "main",
		"INFO_PREFIX": "info",
		"INFO_FILES": "chaplist.yaml,infolist.json,nicklist.yaml,spinfo.json",
		"HTML_PREFIX": "html",
		"HTML_DIRS": ""
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
